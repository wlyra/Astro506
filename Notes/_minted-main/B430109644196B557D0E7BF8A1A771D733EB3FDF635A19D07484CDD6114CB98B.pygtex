\PYG{n}{coefficients}\PYG{o}{=}\PYG{n}{np}\PYG{o}{.}\PYG{n}{matmul}\PYG{p}{(}\PYG{n}{a\PYGZus{}inv}\PYG{p}{,}\PYG{n}{rhs}\PYG{p}{)}
